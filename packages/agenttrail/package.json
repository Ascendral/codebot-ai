{
  "name": "agenttrail",
  "version": "0.1.0",
  "description": "Tamper-evident flight recorder + policy gate for AI agents. Hash-chained audit log, policy enforcement, risk scoring, SARIF export. Zero dependencies.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/*.test.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "ai-agent",
    "audit-log",
    "hash-chain",
    "tamper-evident",
    "policy-engine",
    "risk-scoring",
    "sarif",
    "governance",
    "compliance",
    "claude-code",
    "agent-security"
  ],
  "author": "Ascendral",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.test.*",
    "README.md"
  ],
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0"
  }
}
